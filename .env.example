# SwarmSync Agents Gateway — environment variable reference

# ============================================================================
# Genesis Agents (marketplace runtime — swarmsync-agents service only)
# ============================================================================

# Ed25519 signing keypair for VCAP wrapper JWTs.
# Generate with:
#   python -c "import base64; from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; k = Ed25519PrivateKey.generate(); priv = base64.b64encode(k.private_bytes(serialization.Encoding.Raw, serialization.PrivateFormat.Raw, serialization.NoEncryption())).decode(); pub = base64.b64encode(k.public_key().public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)).decode(); print('PRIV:', priv); print('PUB:', pub)"
# Without these, proofs are emitted unsigned (alg=none) — fine for dev, not for production.
GENESIS_GATEWAY_PRIVKEY_B64=
GENESIS_GATEWAY_PUBKEY_B64=

# AES-256-GCM key for encrypting buyer Conduit browser sessions at rest.
# 32 random bytes, base64-encoded. Generate with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Without this, /jobs/{job_id}/session returns vault_not_configured and
# Concierge Mode is disabled (output-only delivery still works).
GENESIS_SESSION_VAULT_KEY=

# NOTE: the former admin email allowlist was removed. /admin/* now requires the
# gateway credential PLUS a signed principal holding the "admin" scope, granted
# per client in trusted_ap2_clients.json. There is no env-var admin bypass.

# ============================================================================
# Auth — required for production deployments
# ============================================================================

# Public API key checked on every /agents/{slug}/run, /a2a, /jobs/* request
# via the X-Agent-Api-Key header. If unset, the gateway is open (dev mode).
# Must match AGENTS_GATEWAY_API_KEY on swarmsync-api AND the GATEWAY_API_KEY
# stored in Cato's vault.
GATEWAY_API_KEY=

# Shared secret for internal swarmsync-api → agents-gateway calls.
# swarmsync-api's executeAgent() sends this as x-agent-gateway-secret.
# Must match AGENT_GATEWAY_SECRET on swarmsync-api.
# verify_gateway_key accepts EITHER GATEWAY_API_KEY or AGENT_GATEWAY_SECRET.
AGENT_GATEWAY_SECRET=

# REQUIRED for signed AP2 identity (runtime/request_auth.py). Without both of
# these every AP2-signed request from Cato fails closed with HTTP 401, and the
# gateway silently falls back to the shared-key legacy principal, which cannot
# read owner-scoped jobs, artifacts or retrieval results.
#
# GENESIS_AUTH_DB_PATH: SQLite file recording consumed AP2 nonces so a captured
#   envelope cannot be replayed. Must be on a persistent disk in production —
#   an ephemeral path silently re-opens the replay window on every restart.
# GENESIS_PRINCIPAL_TOKEN_KEY: >=32 chars, HMAC key for the short-lived
#   owner-scoped continuation tokens Cato uses to poll its own jobs. Rotating
#   it invalidates every outstanding poll token.
GENESIS_AUTH_DB_PATH=/var/data/genesis-auth.db
GENESIS_PRINCIPAL_TOKEN_KEY=

# REQUIRED before any APPROVAL_REQUIRED tool can dispatch (runtime/action_grants.py).
# >=32 chars, HMAC key for single-use, payload-bound, expiring action grants.
GENESIS_ACTION_GRANT_KEY=

# Separate approval credential required before any deployment-class tool can
# execute. Invocation auth alone never authorizes a real external deployment.
GENESIS_DEPLOYMENT_APPROVAL_TOKEN=

# Genesis-owned local tamper-evident audit database. Must be a persistent-disk
# path in production; never point this at Cato's operator database.
GENESIS_AUDIT_DB_PATH=/var/data/genesis-audit.db
GENESIS_ANCHOR_STORE_PATH=/var/data/genesis-anchors.jsonl

# LLM endpoint configuration.
#
# PROVIDER SELECTION (GENESIS_LLM_PROVIDER) — two supported wire formats:
#
#   anthropic  -> POST {LLM_API_URL}/v1/messages, headers x-api-key +
#                 anthropic-version, Anthropic Messages body. LLM_API_KEY must
#                 hold the ANTHROPIC_API_KEY value. Model ids are translated at
#                 the wire (runtime/anthropic_wire.py) because the bundles carry
#                 gateway-style ids like `anthropic/claude-sonnet-4-5` that the
#                 Anthropic API rejects.
#   openai     -> POST LLM_API_URL as-is with an OpenAI chat-completions body
#                 and Authorization: Bearer. This is the SwarmSync gateway path.
#
# Leave GENESIS_LLM_PROVIDER EMPTY to auto-detect from the URL: an
# api.anthropic.com URL selects the Anthropic path, anything else selects the
# OpenAI path. Set it explicitly to force a path without editing the URL.
#
# DEFAULT BELOW IS THE GATEWAY PATH, deliberately, so an existing deployment
# does not change behaviour by upgrading. To run directly against Anthropic:
#   GENESIS_LLM_PROVIDER=anthropic
#   LLM_API_URL=https://api.anthropic.com
#   LLM_API_KEY=<your ANTHROPIC_API_KEY>
#
# OpenRouter is only available if GENESIS_ALLOW_OPENROUTER_FALLBACK=true.
GENESIS_LLM_PROVIDER=
LLM_API_URL=https://api.swarmsync.ai/v1/chat/completions
LLM_API_KEY=
# Pass `auto` through to SwarmSync Routing so complexity scoring can choose
# the right economy/mid/premium model tier per request. Set a concrete model
# only when you intentionally want to bypass smart routing.
GENESIS_LLM_MODEL=auto
GENESIS_ALLOW_OPENROUTER_FALLBACK=false

# Platform fee skim — 10% of paid invocations routes to the treasury.
# X402_PLATFORM_WALLET_ADDRESS lives in the existing payments config.
SWARMSYNC_PLATFORM_FEE_PCT=0.10

# Postgres-backed job store + worker queue.
# DATABASE_URL is shared with the API service.
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_S=2
WORKER_HEARTBEAT_INTERVAL_S=20
WORKER_STALE_CHECK_INTERVAL_S=60

# Optional — fallback to S3 if local Render disk insufficient
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# GENESIS_S3_BUCKET=swarmsync-genesis-artifacts
# GENESIS_SIGNED_URL_TTL_SECONDS=604800

# ============================================================================
# Phase 7: In-process auto-worker (Phase 7 hardening)
# Set GENESIS_WORKER_ENABLED=true to run the job worker inside FastAPI itself.
# This eliminates the need for the external tick endpoint and a separate worker process.
# ============================================================================
GENESIS_WORKER_ENABLED=true
GENESIS_WORKER_INTERVAL_SECONDS=10
GENESIS_WORKER_TICK_LIMIT=3

# ============================================================================
# Phase 2/6: Workspace lifecycle (Phase 2/6 hardening)
# ============================================================================
# GENESIS_WORKSPACE_ROOT=/tmp/jobs
# GENESIS_WORKSPACE_RETAIN_FAILED_HOURS=24
# GENESIS_WORKSPACE_RETAIN_SUCCESS_HOURS=1
# GENESIS_WORKSPACE_CLEANUP_ENABLED=true

# ============================================================================
# CHUNK_4_RETRIEVAL: E4L Retrieval Contract route (POST /retrieval/query)
# ============================================================================

# Assistant-tier PG (pgvector/pg_diskann), e4l_knowledge database — provisioned and populated
# by a different, external workstream (master spec §17 Phase E: e4l-work-os/Cato, not Genesis).
# May stay unset locally; the route degrades to a structured HTTP-200 refusal
# ({"refusal": true, "chunks": [], "degraded": true, "degraded_reason": "..."}) rather than
# failing to boot or 500ing. Minimum expected column shape (see retrieval_store.py's module
# docstring for the full contract): chunk_id text, vault_path text, heading_path text,
# chunk_index int, content_sha256 text, content_text text, embedding vector, entity text,
# type text, status text, updated date, supersedes text[], indexed_at timestamptz.
ASSISTANT_PG_DATABASE_URL=

# Refusal-path threshold: chunks scoring below this are excluded; if nothing scores at or
# above it, the route returns the structured refusal shape (HTTP 200, chunks: []).
RETRIEVAL_MIN_SCORE=0.35

# Staleness flag cutoff: index_updated_at older than this many hours sets stale=true on the
# response. Never hides staleness by silently answering as if current.
RETRIEVAL_STALENESS_THRESHOLD_HOURS=24

# ============================================================================
# CHUNK_4_RETRIEVAL (E4L Drive Knowledge Integration): knowledge_backbone second backend
# ============================================================================

# Set at most one of these two — SPEC-e4l-drive-knowledge-integration.md's Open Question 3
# (kb-mcp-prod's own query/auth surface vs. a direct read-only Postgres connection to
# knowledge_backbone) is not yet resolved. Until Shreyas/Ben confirm which one, and CHUNK_6
# wires the real client, knowledge_backbone_store.py always raises regardless of which of these
# is set — the route catches that and reports partial:true rather than fabricating a Drive
# answer. Both stay unset in every environment today; do not set either speculatively.
KNOWLEDGE_BACKBONE_MCP_ENDPOINT=
KNOWLEDGE_BACKBONE_DATABASE_URL=

# --- Arize Phoenix / OpenInference tracing (runtime/phoenix_tracing.py) -------
# Phoenix replaces LangSmith as the tracing/eval backend. Both are never live at
# once: when PHOENIX_COLLECTOR_ENDPOINT is set, eval.traceable.tracing_enabled()
# reports False and the LangSmith path stays dormant, so the same agent inputs
# and outputs are never double-shipped to two vendors.
#
# ALL of this is optional and fail-open. With PHOENIX_COLLECTOR_ENDPOINT unset,
# Genesis runs exactly as before and emits no traces. A Phoenix outage must
# never block an agent run or a money path.

# Phoenix collector base URL, WITHOUT the /v1/traces suffix (the exporter
# appends it). Phoenix Cloud is space-scoped and looks like:
#   https://app.phoenix.arize.com/s/<your-space>
# The bare app.phoenix.arize.com host serves the web console's OAuth flow, not
# the collector API, so the /s/<space> segment is required. Read the exact value
# off the Phoenix Cloud UI; it cannot be derived from the API key.
# PHOENIX_ENDPOINT and OTEL_EXPORTER_OTLP_ENDPOINT are accepted as aliases.
PHOENIX_COLLECTOR_ENDPOINT=

# Phoenix API key, sent as `Authorization: Bearer <key>`. Already present in the
# untracked .env and in the Render service; no new credential is required.
PHOENIX_API_KEY=

# Phoenix project the spans land in. Defaults to "genesis-agents".
PHOENIX_PROJECT_NAME=

# Set to 0/false to disable tracing while leaving the endpoint configured.
PHOENIX_TRACING=

# Content capture, OFF by default. Spans normally carry only ids, counts, model
# names, tool names, latencies and verdicts — never prompt text, retrieved
# knowledge_backbone content, or estate/ledger data.
#
# PHOENIX_TRACE_CONTENT=1 enables redacted content capture (via eval/redaction.py).
# If the collector is NOT loopback, PHOENIX_ALLOW_CONTENT_OFFBOX=1 is ALSO
# required. Phoenix Cloud is a third-party SaaS, so exporting E4L content there
# is always a deliberate operator decision, never an accident.
PHOENIX_TRACE_CONTENT=
PHOENIX_ALLOW_CONTENT_OFFBOX=
